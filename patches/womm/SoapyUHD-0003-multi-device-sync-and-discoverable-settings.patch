+class SoapyUHDDevice;
+
+/*!
+ * Process-wide registry of live SoapyUHDDevice instances.
+ *
+ * A USB B2xx is one device with one mboard (b200_impl.cpp hardcodes /mboards/0), so a
+ * multi_usrp can never span several of them and ALL_MBOARDS cannot reach them. Separate
+ * devices therefore have no way to receive one command together, and every application
+ * driving more than one B2xx has had to rebuild the same host-side loop.
+ *
+ * This registry lets the driver do it once instead.
+ */
+static std::mutex &soapyUHDRegistryMutex(void)
+{
+    static std::mutex m;
+    return m;
+}
+
+static std::vector<SoapyUHDDevice *> &soapyUHDRegistry(void)
+{
+    static std::vector<SoapyUHDDevice *> devices;
+    return devices;
+}
+
 class SoapyUHDDevice : public SoapySDR::Device
 {
 public:
