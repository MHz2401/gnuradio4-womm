/conan.cmake
conan.lock
conanbuildinfo.cmake
conanbuildinfo.txt
conanfile.txt
conaninfo.txt

graph_info.json

# Library files
lib/

# Binary files
imgui.ini
bin/
build/
build*/
build_*/
out/
cmake-build-*/

