# - - - - - - - - - - - - - - - - -
#  OS/IDE CRUFT
# --- OS JUNK (The "Dang Things") ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db


